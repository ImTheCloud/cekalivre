# Copie ce fichier en `.env.local` (ignoré par git) et remplis les valeurs.
# Les variables EXPO_PUBLIC_* sont incluses dans l'app : n'y mets jamais un secret critique.
# (Le jeton API ci-dessous est une simple protection anti-abus du serveur, ça suffit pour la v0.)

# URL du backend d'optimisation. Laisse vide en développement :
# l'app utilisera automatiquement http://<IP de ton Mac>:8000 (même Wi-Fi que le téléphone).
EXPO_PUBLIC_API_URL=

# Jeton partagé avec le backend (même valeur que API_TOKEN dans backend/.env).
EXPO_PUBLIC_API_TOKEN=

# Clés Google Maps SDK — uniquement pour les builds natives (EAS), inutiles dans Expo Go.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
