# Copie ce fichier en `.env` (ignoré par git).

# Jeton partagé avec l'app (même valeur que EXPO_PUBLIC_API_TOKEN dans app/.env.local).
# Génère-en un avec : openssl rand -hex 24
API_TOKEN=

# Serveur OSRM pour les vrais temps de trajet.
#   - vide : estimation à vol d'oiseau (suffisant pour développer l'app)
#   - https://router.project-osrm.org : serveur de démo public, OK pour quelques tests, PAS pour un usage quotidien
#   - avec docker compose : fixé automatiquement à http://osrm:5000
OSRM_URL=

# Géocodeurs essayés dans l'ordre : photon, nominatim, google
GEOCODERS=photon,nominatim
# Optionnel : clé Google Geocoding API (ajoute "google" à GEOCODERS pour l'utiliser en dernier recours).
GOOGLE_GEOCODING_API_KEY=

# Nom de domaine pointant vers le serveur (HTTPS automatique via Caddy), ex. cekalivre.duckdns.org
DOMAIN=

# Sur un serveur avec HTTPS (Caddy), n'expose l'API qu'en local : API_BIND=127.0.0.1
API_BIND=0.0.0.0
